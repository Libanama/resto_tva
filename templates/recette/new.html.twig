{% extends 'base.html.twig' %}

{% block title %}Nouvelle recette{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header bg-dark text-white">
                <i class="bi bi-plus-circle"></i> Nouvelle recette
            </div>
            <div class="card-body">
                {{ form_start(form) }}

                <div class="mb-3">
                    {{ form_label(form.date, 'Date', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.date, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.date) }}
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold" style="color:#10b981">
                        Recettes TTC à 5,5%
                        <small class="text-muted fw-normal">— Pain, eau, produits de première nécessité</small>
                    </label>
                    {{ form_widget(form.ttc55, {'attr': {'class': 'form-control', 'placeholder': '0.00', 'step': '0.01', 'min': '0'}}) }}
                    {{ form_errors(form.ttc55) }}
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold" style="color:#f59e0b">
                        Recettes TTC à 10%
                        <small class="text-muted fw-normal">— Repas, boissons non alcoolisées</small>
                    </label>
                    {{ form_widget(form.ttc10, {'attr': {'class': 'form-control', 'placeholder': '0.00', 'step': '0.01', 'min': '0'}}) }}
                    {{ form_errors(form.ttc10) }}
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold" style="color:#ef4444">
                        Recettes TTC à 20%
                        <small class="text-muted fw-normal">— Boissons alcoolisées</small>
                    </label>
                    {{ form_widget(form.ttc20, {'attr': {'class': 'form-control', 'placeholder': '0.00', 'step': '0.01', 'min': '0'}}) }}
                    {{ form_errors(form.ttc20) }}
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold" style="color:#8b5cf6">
                        Pourboires
                        <small class="text-muted fw-normal">— Non soumis à TVA, suivi séparé</small>
                    </label>
                    {{ form_widget(form.pourboire, {'attr': {'class': 'form-control', 'placeholder': '0.00', 'step': '0.01', 'min': '0'}}) }}
                    {{ form_errors(form.pourboire) }}
            </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg"></i> Enregistrer
                    </button>
                    <a href="{{ path('app_recette_index') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Annuler
                    </a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}