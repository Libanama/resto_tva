{% extends 'base.html.twig' %}

{% block title %}Recettes — {{ mois }}/{{ annee }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-cash-stack"></i> Recettes</h1>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex gap-2">
            <select name="mois" class="form-select form-select-sm" style="width:130px">
                {% set moisNoms = {1: 'Janvier', 2: 'Février', 3: 'Mars', 4: 'Avril', 5: 'Mai', 6: 'Juin', 7: 'Juillet', 8: 'Août', 9: 'Septembre', 10: 'Octobre', 11: 'Novembre', 12: 'Décembre'} %}
                {% for num, nom in moisNoms %}
                    <option value="{{ num }}" {% if num == mois %}selected{% endif %}>{{ nom }}</option>
                {% endfor %}
            </select>
            <select name="annee" class="form-select form-select-sm" style="width:100px">
                {% for a in annee-1..annee+1 %}
                    <option value="{{ a }}" {% if a == annee %}selected{% endif %}>{{ a }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="btn btn-outline-primary btn-sm">Filtrer</button>
        </form>
        <a href="{{ path('app_recette_new') }}" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg"></i> Nouvelle recette
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        {% if recettes is empty %}
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mt-2">Aucune recette pour cette période.</p>
                <a href="{{ path('app_recette_new') }}" class="btn btn-primary btn-sm">Ajouter une recette</a>
            </div>
        {% else %}
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Date</th>
                        <th class="text-end">TTC 5,5%</th>
                        <th class="text-end" style="color:#6ee7b7">TVA 5,5%</th>
                        <th class="text-end">TTC 10%</th>
                        <th class="text-end" style="color:#42C5F5">TVA 10%</th>
                        <th class="text-end">TTC 20%</th>
                        <th class="text-end" style="color:#fca5a5">TVA 20%</th>
                        <th class="text-end" style="color:#8b5cf6">Pourboires</th>
                        <th class="text-end pe-4">Total TTC</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for recette in recettes %}
                    {% set t55 = recette.ttc55|default(0)|number_format(2, ',', ' ') %}
                    {% set t10 = recette.ttc10|default(0)|number_format(2, ',', ' ') %}
                    {% set t20 = recette.ttc20|default(0)|number_format(2, ',', ' ') %}
                    {% set tva55 = (recette.ttc55|default(0) * 0.055 / 1.055)|number_format(2, ',', ' ') %}
                    {% set tva10 = (recette.ttc10|default(0) * 0.10 / 1.10)|number_format(2, ',', ' ') %}
                    {% set tva20 = (recette.ttc20|default(0) * 0.20 / 1.20)|number_format(2, ',', ' ') %}
                    {% set total = (recette.ttc55|default(0) + recette.ttc10|default(0) + recette.ttc20|default(0))|number_format(2, ',', ' ') %}
                    <tr>
                        <td class="ps-4">{{ recette.date|date('d/m/Y') }}</td>
                        <td class="text-end text-success">{{ recette.ttc55 ? t55~' €' : '—' }}</td>
                        <td class="text-end small text-success opacity-75">{{ recette.ttc55 ? tva55~' €' : '—' }}</td>
                        <td class="text-end" style="color:#42C5F5">{{ recette.ttc10 ? t10~' €' : '—' }}</td>

                        <td class="text-end small" style="color:#42C5F5;opacity:0.85">{{ recette.ttc10 ? tva10~' €' : '—' }}</td>

                        <td class="text-end text-danger">{{ recette.ttc20 ? t20~' €' : '—' }}</td>
                        <td class="text-end small text-danger opacity-75">{{ recette.ttc20 ? tva20~' €' : '—' }}</td>
                        <td class="text-end" style="color:#8b5cf6">{{ recette.pourboire ? recette.pourboire|number_format(2, ',', ' ')~' €' : '—' }}</td>
                        <td class="text-end pe-4 fw-bold">{{ total }} €</td>
                        <td class="text-end pe-2">
                            <form method="post" action="{{ path('app_recette_delete', {id: recette.id}) }}"
                                  onsubmit="return confirm('Supprimer cette recette ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete'~recette.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</div>
{% endblock %}