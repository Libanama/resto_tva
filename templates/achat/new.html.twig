{% extends 'base.html.twig' %}

{% block title %}Nouvel achat{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header bg-dark text-white">
                <i class="bi bi-plus-circle"></i> Nouvel achat
            </div>
            <div class="card-body">
                {{ form_start(form) }}

                <div class="mb-3">
                    {{ form_label(form.date, 'Date', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.date, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.date) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.libelle, 'Libellé / Fournisseur', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.libelle, {'attr': {'class': 'form-control', 'placeholder': 'Ex : Métro, EDF, gaz...'}}) }}
                    {{ form_errors(form.libelle) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.montantHt, 'Montant HT (€)', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.montantHt, {'attr': {'class': 'form-control', 'placeholder': '0.00', 'step': '0.01', 'min': '0'}}) }}
                    {{ form_errors(form.montantHt) }}
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold text-success">
                        TVA déductible (€)
                        <small class="text-muted fw-normal">— Montant TVA figurant sur la facture</small>
                    </label>
                    {{ form_widget(form.tvaDeductible, {'attr': {'class': 'form-control', 'placeholder': '0.00', 'step': '0.01', 'min': '0'}}) }}
                    {{ form_errors(form.tvaDeductible) }}
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg"></i> Enregistrer
                    </button>
                    <a href="{{ path('app_achat_index') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Annuler
                    </a>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}