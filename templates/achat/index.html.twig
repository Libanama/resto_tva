{% extends 'base.html.twig' %}

{% block title %}Achats — {{ mois }}/{{ annee }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-cart3"></i> Achats</h1>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex gap-2">
        <select name="mois" class="form-select form-select-sm" style="width:130px">
            {% set moisNoms = {1: 'Janvier', 2: 'Février', 3: 'Mars', 4: 'Avril', 5: 'Mai', 6: 'Juin', 7: 'Juillet', 8: 'Août', 9: 'Septembre', 10: 'Octobre', 11: 'Novembre', 12: 'Décembre'} %}
            {% for num, nom in moisNoms %}
                <option value="{{ num }}" {% if num == mois %}selected{% endif %}>{{ nom }}</option>
            {% endfor %}
        </select>
            <select name="annee" class="form-select form-select-sm" style="width:100px">
                {% for a in annee-1..annee+1 %}
                    <option value="{{ a }}" {% if a == annee %}selected{% endif %}>{{ a }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="btn btn-outline-primary btn-sm">Filtrer</button>
        </form>
        <a href="{{ path('app_achat_new') }}" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg"></i> Nouvel achat
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        {% if achats is empty %}
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mt-2">Aucun achat pour cette période.</p>
                <a href="{{ path('app_achat_new') }}" class="btn btn-primary btn-sm">Ajouter un achat</a>
            </div>
        {% else %}
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">Date</th>
                        <th>Libellé</th>
                        <th class="text-end">Montant HT</th>
                        <th class="text-end">TVA déductible</th>
                        <th class="text-end pe-4">TTC</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for achat in achats %}
                    <tr>
                        <td class="ps-4">{{ achat.date|date('d/m/Y') }}</td>
                        <td>{{ achat.libelle }}</td>
                        <td class="text-end">{{ achat.montantHt|number_format(2, ',', ' ') }} €</td>
                        <td class="text-end text-success fw-bold">{{ achat.tvaDeductible|number_format(2, ',', ' ') }} €</td>
                        <td class="text-end pe-4">{{ (achat.montantHt + achat.tvaDeductible)|number_format(2, ',', ' ') }} €</td>
                        <td class="text-end pe-2">
                            <form method="post" action="{{ path('app_achat_delete', {id: achat.id}) }}"
                                  onsubmit="return confirm('Supprimer cet achat ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete'~achat.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</div>
{% endblock %}